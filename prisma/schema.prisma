generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. 大脑配置：存储 API Key 和模型选型
model Brain {
  id        String   @id @default(uuid())
  name      String
  provider  String
  modelName String
  apiKey    String
  baseUrl   String?
  type      String   @default("chat")  // "chat" | "image"
  createdAt DateTime @default(now())
  roles     Role[]
}

// 2. 有灵魂的个体：直接参与对话的实体
model Role {
  id        String    @id @default(uuid())
  name      String
  soul      String
  rule      String
  summary   String?   // LLM 压缩后的历史对话摘要，始终拼入 system prompt
  avatar    String?
  brain     Brain     @relation(fields: [brainId], references: [id])
  brainId   String
  messages  Message[]
  createdAt DateTime  @default(now())

  @@index([brainId])
}

// 3. 原始对话记录（短期记忆来源）
model Message {
  id        String   @id @default(uuid())
  content   String
  sender    String   // user / assistant / system
  type      String   @default("text")  // "text" | "image"
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  createdAt DateTime @default(now())

  @@index([roleId])
}

// 4. Agent 会话：一次独立的 agent 任务
model AgentSession {
  id          String     @id @default(uuid())
  roleId      String
  title       String     // 自动摘要或用户命名
  status      String     @default("active")  // "active" | "archived"
  summary     String?    // LLM 压缩摘要，autoCompact 后写入
  compactedAt DateTime?  // 最后压缩时间
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  messages    AgentMessage[]

  @@index([roleId])
}

// 5. Agent 消息：包含 tool_use/tool_result 的多角色消息
model AgentMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String   // "user" | "assistant" | "tool_use" | "tool_result"
  content   String
  type      String   @default("text")  // "text" | "tool_call" | "tool_result"
  toolName  String?  // tool_use 的工具名
  toolId    String?  // tool_use_id，匹配 tool_use/tool_result
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// 6. 辩论赛
model Debate {
  id          String   @id @default(uuid())
  proTopic    String   // 正方辩题
  conTopic    String   // 反方辩题
  background  String?  // 背景资料
  debugMode   Boolean  @default(false) // 调试模式
  summary     String?  // 辩论结束后由裁判 LLM 输出自动生成的摘要
  status      String   @default("ongoing") // "ongoing" | "completed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions   DebatePosition[]
  messages    DebateMessage[]
  scores      DebateScore[]
  result      DebateResult?
}

model DebatePosition {
  id        String @id @default(uuid())
  debateId  String
  roleId    String // FK → Role.id
  side      String // "pro" | "con" | "judge"
  position  Int    // 1-4（judge 为 0）
  brainId   String // 冗余存储方便查询

  debate    Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([debateId])
}

model DebateMessage {
  id          String   @id @default(uuid())
  debateId    String
  roleId      String   // 发言者 roleId
  side        String   // "pro" | "con" | "judge"
  position    Int      // 1-4（judge 为 0）
  round       String   // "opening" | "rebuttal" | "cross" | "free" | "closing" | "judging"
  content     String   // 发言内容
  tokenCount  Int?     // 该发言消耗的 token 数（仅供参考，编排逻辑已改用字数）
  charCount   Int?     // 发言的实际字数（用于编排判定）
  roundIndex  Int      // 全场第几轮发言
  createdAt   DateTime @default(now())

  debate      Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId, createdAt])
}

model DebateScore {
  id              String   @id @default(uuid())
  debateId        String
  roleId          String
  side            String   // "pro" | "con"
  position        Int      // 1-4
  scoreContent    Int?     // 内容/论据 (30%)
  scoreLogic      Int?     // 逻辑/推理 (25%)
  scoreExpression Int?     // 表达/语言 (20%)
  scoreRebuttal   Int?     // 反驳/应变 (25%)
  totalScore      Float?   // 加权总分
  judgeComment    String?  // 裁判评语
  createdAt       DateTime @default(now())

  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId])
}

model DebateResult {
  id              String   @id @default(uuid())
  debateId        String   @unique
  winner          String   // "pro" | "con"
  bestPro         Int?     // 正方最佳辩手 position
  bestCon         Int?     // 反方最佳辩手 position
  overallBest     Int?     // 全场最佳辩手 position
  bestSide        String?  // "pro" | "con"
  judgeSummary    String?  // 裁判总结
  createdAt       DateTime @default(now())

  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
}

